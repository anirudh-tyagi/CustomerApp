{
  "name": "customer-map-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:demo": "python3 scripts/make_demo_db.py --out data/db/custom/customers.db --no-csv",
    "db:stress": "python3 scripts/make_demo_db.py --count 10000 --out data/fixtures/customers_10000.db --no-csv",
    "db:bad": "python3 scripts/make_demo_db.py --count 500 --bad-rows --out data/fixtures/customers_test_bad_rows.db --no-csv"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "@op-engineering/op-sqlite": "19.0.3",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/jest": "^29.5.13",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
